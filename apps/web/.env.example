DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# Stable random secret (at least 32 characters) shared by all server instances.
# Used to encrypt short-lived, single-use CLI authorizations in the credentials table.
FORJEX_SESSION_SECRET=replace-with-a-long-random-secret
