{
  "name": "forjex",
  "version": "1.8.0",
  "type": "module",
  "description": "Automate GitHub repo creation and Vercel deployment",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:cli": "tsup",
    "build:web": "npm --prefix apps/web run build",
    "build:all": "npm run build:cli && npm run build:web",
    "dev": "tsx src/index.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "prepublishOnly": "npm run build:cli",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:cli && npm --prefix apps/web run test",
    "test:cli": "node --import ./node_modules/tsx/dist/loader.mjs --test tests/*.test.mts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "npm run typecheck:cli && npm run typecheck:web",
    "typecheck:cli": "tsc --noEmit",
    "typecheck:web": "tsc --project apps/web/tsconfig.json --noEmit --incremental false"
  },
  "keywords": [
    "cli",
    "github",
    "vercel",
    "deployment",
    "automation"
  ],
  "author": "David Mgbede",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daviddozie/forjex.git"
  },
  "bin": {
    "forjex": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@octokit/auth-oauth-device": "^8.0.3",
    "@octokit/rest": "^22.0.1",
    "@vercel/client": "^17.2.12",
    "axios": "^1.13.2",
    "chalk": "^6.0.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "figlet": "^1.9.4",
    "inquirer": "^13.0.1",
    "open": "^11.0.0",
    "ora": "^9.0.0",
    "simple-git": "^3.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
